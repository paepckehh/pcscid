# pcscid bridge mode — loopback HTTP bridge from pcscd to a kiosk browser
# page. Runs the same pcscid binary with PCSCID_HTTP_ADDR set, so every
# card presentation's reader tag (xx-xxxx-xx) and card btag (xxx-xxx-xxxx) are
# served on http://127.0.0.1:8976 (loopback only). Install next to the
# kiosk browser on the terminal:
#
#   sudo cp pcscid /usr/local/bin/
#   sudo cp scripts/pcscid-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pcscid-bridge
#
# Build the binary with: make build
[Unit]
Description=pcscid bridge mode (pcscd card events as loopback SSE/polling for kiosk pages)
Documentation=https://paepcke.de/pcscid
Wants=pcscd.service
After=pcscd.service network-online.target

[Service]
Type=simple
Environment=PCSCID_HTTP_ADDR=127.0.0.1:8976
# Reader identity: a shell export never reaches a systemd service, the
# options must live here in the unit. PCSCID_USB_PATH_ID anchors
# serial-less readers (ACS ACR122U) to their physical USB port: one
# stable tag per unit and port across daemon restarts and reboots.
Environment=PCSCID_USB_PATH_ID=1
# Scope every reader tag to this machine's hardware MACs (distinct tags
# per kiosk, tags no longer follow the reader to another machine):
#Environment=PCSCID_MAC_ID=1
# Sign every served line with an ssh-ed25519 key (path, passphrase-less):
#Environment=PCSCID_SIGN_KEY=/etc/pcscid/ed25519
ExecStart=/usr/local/bin/pcscid
Restart=always
RestartSec=2
# Hardening: the bridge only needs the pcscd socket and its loopback listener.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
# pcscd itself is reached over its world-accessible socket in /run/pcscd;
# readers are polled there, never opened directly.

[Install]
WantedBy=multi-user.target
